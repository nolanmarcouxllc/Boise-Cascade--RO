# Copy to .env and fill in. .env is gitignored; this template is safe to commit.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Public anon key (safe for client use, subject to RLS).
SUPABASE_ANON_KEY=

# Service role key: bypasses RLS. Server-side ONLY -- never ship to a browser/client.
# Supabase dashboard -> Project Settings -> API -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=
